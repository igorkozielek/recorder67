# HuggingFace Access Token dla PyAnnote speaker-diarization-3.1
# Pobierz swój token na stronie: https://huggingface.co/settings/tokens
# Upewnij się, że zaakceptowałeś warunki modeli pyannote/segmentation-3.0 oraz pyannote/speaker-diarization-3.1
HF_TOKEN=hf_TWOJ_TOKEN_HUGGINGFACE_TUTAJ

# --- INTEGRACJA CHMUROWA / CLOUD SYNC & CRM ---
# Cel synchronizacji: 'emanager' (bezpośrednio do Supabase EMANAGER.PRO) | 'generic_webhook' (dowolny zewnętrzny CRM/n8n) | 'none'
SYNC_TARGET=emanager

# Konfiguracja Supabase (EMANAGER.PRO lub własna instancja)
SUPABASE_URL=https://twoj-projekt.supabase.co
SUPABASE_KEY=twoj_supabase_anon_lub_publishable_key


# Identyfikacja stanowiska i organizacji (Agnostyczna / Multi-Tenant)
ORGANIZATION_ID=default_org
DEVICE_NAME=Biuro-Stanowisko-1
AUTO_CLOUD_SYNC=true
SYNC_UPLOAD_AUDIO=true

# Opcjonalny webhook (jeśli SYNC_TARGET=generic_webhook)
# GENERIC_WEBHOOK_URL=https://twoj-serwer-n8n.pl/webhook/meeting-ingest