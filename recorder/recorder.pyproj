<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>2fbdf51b-144e-45b3-83a6-930e9b627a4d</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>main.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>recorder</Name>
    <RootNamespace>recorder</RootNamespace>
    <InterpreterId>MSBuild|env|$(MSBuildProjectFullPath)</InterpreterId>
    <IsWindowsApplication>True</IsWindowsApplication>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="audio\" />
    <Folder Include="core\" />
    <Folder Include="ui\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="__init__.py" />
    <Compile Include="config.py" />
    <Compile Include="main.py" />
    <Compile Include="recorder.py" />
    <Compile Include="test.py" />
    <Compile Include="audio\__init__.py" />
    <Compile Include="audio\capture.py" />
    <Compile Include="audio\converter.py" />
    <Compile Include="audio\devices.py" />
    <Compile Include="core\__init__.py" />
    <Compile Include="core\cloud_sync.py" />
    <Compile Include="core\diarizer.py" />
    <Compile Include="core\speakers.py" />
    <Compile Include="core\transcriber.py" />
    <Compile Include="core\vad.py" />
    <Compile Include="ui\__init__.py" />
    <Compile Include="ui\theme.py" />
    <Compile Include="ui\window.py" />
    <Compile Include="ui\workers.py" />
    <Compile Include="..\main.py">
      <Link>main_root.py</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\.env" Condition="Exists('..\.env')">
      <Link>.env</Link>
    </Content>
    <Content Include="..\.env.example">
      <Link>.env.example</Link>
    </Content>
    <Content Include="..\PROJECT_GOAL.md">
      <Link>PROJECT_GOAL.md</Link>
    </Content>
    <Content Include="..\README.md">
      <Link>README.md</Link>
    </Content>
    <Content Include="..\requirements.txt">
      <Link>requirements.txt</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include="..\env\">
      <Id>env</Id>
      <Version>3.13</Version>
      <Description>env (Python 3.13 (64-bit))</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />

  <!-- Uncomment the CoreCompile target to enable the Build command in
       Visual Studio and specify your pre- and post-build commands in
       the BeforeBuild and AfterBuild targets below. -->
  <!--<Target Name="CoreCompile" />-->
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
</Project>